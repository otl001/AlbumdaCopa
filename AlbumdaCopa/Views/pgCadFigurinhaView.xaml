<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlbumdaCopa.Views.pgCadFigurinhaView"
             Title="Cadastrar Figurinha"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20" HorizontalOptions="Center" WidthRequest="400">
            
            <Image Source="copa2026_header.png" 
                   HeightRequest="100" 
                   Aspect="AspectFill" 
                   HorizontalOptions="Fill" />

            <Label Text="Cadastro de Figurinhas"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#2563EB"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Frame HeightRequest="150" 
                       WidthRequest="120" 
                       Padding="0" 
                       CornerRadius="10" 
                       BorderColor="#CBD5E1"
                       BackgroundColor="#FFFFFF"
                       HasShadow="True">
                    <Image x:Name="imgPreview" 
                           Source="dotnet_bot.png" 
                           Aspect="AspectFill" />
                </Frame>

                <Button Text="Selecionar foto"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        HeightRequest="40"
                        CornerRadius="8"
                        Clicked="OnSelecionarFotoClicked" />
                
                <Label x:Name="lblFotoPath" 
                       FontSize="11" 
                       TextColor="#475569" 
                       Opacity="0.8" 
                       HorizontalOptions="Center" 
                       LineBreakMode="HeadTruncation" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="12" ColumnSpacing="12">

                <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
                    <Label Text="Nome do Jogador *" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                    <Entry x:Name="txtNomeJogador" 
                           TextColor="#0F172A"
                           BackgroundColor="#FFFFFF" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                    <Label Text="Seleção *" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                    <Picker x:Name="pickerSelecao" 
                            TitleColor="#888888"
                            TextColor="#0F172A"
                            BackgroundColor="#FFFFFF" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                    <Label Text="Tipo de Figurinha " TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                    <Picker x:Name="pickerTipo" 
                            TitleColor="#888888"
                            TextColor="#0F172A"
                            BackgroundColor="#FFFFFF">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Comum</x:String>
                                <x:String>Especial</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="6" HorizontalOptions="Center">
                    <Label Text="Adquirido?" TextColor="#0F172A" FontSize="13" HorizontalOptions="Center" />
                    <Switch x:Name="switchObtido" OnColor="#2563EB" ThumbColor="#FFFFFF" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            
            <Button Text="Salvar Figurinha"
                    BackgroundColor="#2563EB"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="10"
                    Margin="0,15,0,20"
                    Clicked="OnSalvarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
