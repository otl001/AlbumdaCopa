<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AlbumdaCopa.Views"
             x:Class="AlbumdaCopa.Views.pgAlbumView"
             Title="Meu Álbum de Figurinhas"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />
            <local:RepeatedCountConverter x:Key="RepeatedCountConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        

        <Image Grid.Row="0" 
               Source="copa2026_header.png" 
               HeightRequest="80" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" />

        <Frame Grid.Row="1" 
               BackgroundColor="#FFFFFF" 
               BorderColor="#E2E8F0" 
               CornerRadius="10" 
               Margin="10" 
               Padding="12"
               HasShadow="True">
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="Selecione a Seleção:" 
                       TextColor="#0F172A" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" 
                       FontSize="14" />
                
                <Picker x:Name="pickerSelecao" 
                        TextColor="#0F172A"
                        BackgroundColor="#FFFFFF"
                        WidthRequest="200"
                        SelectedIndexChanged="OnSelecaoChanged" />
            </HorizontalStackLayout>
        </Frame>
        
        <CollectionView Grid.Row="2" 
                        x:Name="collectionViewAlbum" 
                        Margin="10,0,10,10"
                        SelectionMode="None">
            
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#FFFFFF"
                           BorderColor="#E2E8F0"
                           CornerRadius="8" 
                           Padding="5" 
                           HeightRequest="185"
                           HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSlotTapped" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            
                            <Grid HeightRequest="120" WidthRequest="95" HorizontalOptions="Center">
                                
                                <Frame Padding="0" 
                                       CornerRadius="5" 
                                       BorderColor="#CBD5E1" 
                                       BackgroundColor="#F8FAFC"
                                       HasShadow="False"
                                       IsVisible="{Binding NoAlbum}">
                                    <Image Source="{Binding FotoPath}" Aspect="AspectFill" />
                                </Frame>

                                <!-- silhueta de jogar -->
                                <Frame Padding="0" 
                                       CornerRadius="5" 
                                       BorderColor="#E2E8F0" 
                                       BackgroundColor="#F1F5F9"
                                       HasShadow="False"
                                       IsVisible="{Binding NoAlbum, Converter={StaticResource InverseBoolConverter}}">
                                    <Label Text="👤" 
                                           FontSize="40" 
                                           TextColor="#94A3B8"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </Frame>

                                <!-- indicar repitidas -->
                                <Frame BackgroundColor="#EF4444"
                                       BorderColor="#FFFFFF"
                                       CornerRadius="10"
                                       Padding="4,0"
                                       HeightRequest="20"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       Margin="0,-5,-5,0"
                                       HasShadow="False"
                                       IsVisible="{Binding Quantidade, Converter={StaticResource RepeatedCountConverter}}">
                                    <Label Text="{Binding Quantidade, StringFormat='Rpt x{0}'}"
                                           TextColor="#FFFFFF"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                </Frame>
                                
                            </Grid>

                            <Label Text="{Binding NomeJogador}" 
                                   FontSize="8.5" 
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" 
                                   HorizontalTextAlignment="Center" 
                                   LineBreakMode="TailTruncation"
                                   WidthRequest="95"
                                   Margin="0,2,0,0" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
