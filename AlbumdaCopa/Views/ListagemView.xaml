<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controllers="clr-namespace:AlbumdaCopa.Controllers"
             x:Class="AlbumdaCopa.Views.ListagemView"
             Title="Minha Coleção"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Header Temático -->
        <Image Grid.Row="0" 
               Source="copa2026_header.png" 
               HeightRequest="80" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" />

        <!-- Filtros Combinados no Topo -->
        <Frame Grid.Row="1" 
               BackgroundColor="#FFFFFF"
               BorderColor="#E2E8F0"
               CornerRadius="10" 
               Margin="10" 
               Padding="10"
               HasShadow="True">
            <VerticalStackLayout Spacing="10">
                
                <!-- Barra de Busca -->
                <SearchBar x:Name="searchBar"
                           Placeholder="Buscar por jogador..."
                           PlaceholderColor="#888888"
                           TextColor="#0F172A"
                           CancelButtonColor="#0F172A"
                           TextChanged="OnFiltrosChanged" />

                <!-- Switches de Filtros combinados -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Padding="5,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Adquiridas (✔)" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                        <Switch x:Name="switchFiltroObtido" 
                                OnColor="#0F172A"
                                ThumbColor="#FFFFFF"
                                Toggled="OnFiltrosChanged" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Lista de Desejos (♥)" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                        <Switch x:Name="switchFiltroDesejado" 
                                OnColor="#0F172A" 
                                ThumbColor="#FFFFFF" 
                                Toggled="OnFiltrosChanged" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Filtro por Seleção Oficial (Copa 2026 - 48 Times) -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,5,0,0">
                    <Label Text="Filtrar por Seleção:" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                    <Picker x:Name="pickerFiltroSelecao" 
                            Title="Todas"
                            TitleColor="#888888"
                            TextColor="#0F172A"
                            BackgroundColor="#FFFFFF"
                            WidthRequest="180"
                            SelectedIndexChanged="OnFiltrosChanged" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Lista de Figurinhas -->
        <ListView Grid.Row="2"
                  x:Name="listViewFigurinhas"
                  HasUnevenRows="True"
                  SelectionMode="None"
                  SeparatorColor="#F1F5F9"
                  BackgroundColor="Transparent"
                  Margin="10,0,10,10"
                  ItemTapped="OnFigurinhaTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame BackgroundColor="#FFFFFF"
                               BorderColor="#E2E8F0"
                               CornerRadius="10" 
                               Margin="0,5" 
                               Padding="10" 
                               HasShadow="True">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                
                                <!-- Foto Ocupa Maior Espaço Visual -->
                                <Frame Grid.Column="0"
                                       HeightRequest="95" 
                                       WidthRequest="75" 
                                       Padding="0" 
                                       CornerRadius="6" 
                                       BorderColor="#E2E8F0"
                                       BackgroundColor="#F8FAFC"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Image Source="{Binding FotoPath}" Aspect="AspectFill" />
                                </Frame>

                                 <!-- Textos Centrais (Apenas o Nome do Jogador) -->
                                 <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                     <Label Text="{Binding NomeJogador}" 
                                            TextColor="#0F172A" 
                                            FontAttributes="Bold" 
                                            FontSize="15" />
                                 </VerticalStackLayout>

                                <!-- Ícones de Ações à Direita (Botoes Muted / Sem Cores Fortes) -->
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    
                                    <!-- Botão de Status: Obtido -->
                                    <Button Text="☐" 
                                            FontAttributes="Bold"
                                            FontSize="18" 
                                            WidthRequest="40" 
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Padding="0"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#94A3B8"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnAlternarObtidoClicked">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Obtido}" Value="True">
                                                <Setter Property="Text" Value="✔" />
                                                <Setter Property="TextColor" Value="#0F172A" />
                                                <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <!-- Botão de Status: Desejado -->
                                    <Button Text="♡" 
                                            FontAttributes="Bold"
                                            FontSize="18" 
                                            WidthRequest="40" 
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Padding="0"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#94A3B8"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnAlternarDesejadoClicked">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Desejado}" Value="True">
                                                <Setter Property="Text" Value="♥" />
                                                <Setter Property="TextColor" Value="#EF4444" />
                                                <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <!-- Botão Excluir -->
                                    <Button Text="🗑" 
                                            FontAttributes="Bold"
                                            FontSize="16" 
                                            WidthRequest="40" 
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Padding="0"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#94A3B8"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnExcluirClicked" />

                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</ContentPage>
